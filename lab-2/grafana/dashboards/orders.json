{
  "uid": "bookshop-orders",
  "title": "Bookshop orders",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(orders_requests_total[1m]))",
          "legendFormat": "Request rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 2,
      "title": "Error rate",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(orders_errors_total[1m])) / clamp_min(sum(rate(orders_requests_total[1m])), 0.000001)",
          "legendFormat": "Error rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 3,
      "title": "Response time (p95)",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orders_duration_seconds_bucket[1m])))",
          "legendFormat": "Response time (p95)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 4,
      "title": "Order errors · JSON log",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "logs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"orders-api\"} | json | level=\"error\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
